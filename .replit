run = "npm start"
entrypoint = "server.js"

[env]
NODE_ENV = "production"

[[ports]]
localPort = 3000
externalPort = 80

# Required for Replit's Autoscale/Reserved VM publishing — without this
# section, publish fails with "'.replit' is missing the deployment
# section" (confirmed against this exact project on 2026-08-20). `run`
# here is what actually executes in the published container; there's no
# build step since this app has no compile/bundle stage.
[deployment]
run = ["npm", "start"]
deploymentTarget = "cloudrun"
